generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id            String      @id @default(cuid())
  slug          String      @unique
  nameEn        String
  nameBn        String
  descriptionEn String
  descriptionBn String
  price         Int // in BDT
  comparePrice  Int? // original price for showing discounts
  category      String // men | women | kids
  productType   String      @default("") // e.g. panjabi, shirt, saree (see src/lib/catalog.ts)
  occasions     String      @default("") // comma separated, e.g. "eid,pohela-boishakh"
  ageGroup      String // kids only, e.g. "0-2", "3-5" (empty for men/women)
  sizes         String // comma separated, e.g. "S,M,L,XL"
  colors        String // comma separated, e.g. "Red,Blue"
  image         String // image URL or /path
  featured      Boolean     @default(false)
  createdAt     DateTime    @default(now())
  orderItems    OrderItem[]
}

model Order {
  id            Int         @id @default(autoincrement())
  customerName  String
  phone         String
  address       String
  district      String
  note          String?
  paymentMethod String // COD | ONLINE
  paid          Boolean     @default(false)
  tranId        String?     @unique // SSLCommerz transaction id
  deliveryFee   Int
  subtotal      Int
  total         Int
  status        String      @default("PENDING") // PENDING | CONFIRMED | SHIPPED | DELIVERED | CANCELLED
  createdAt     DateTime    @default(now())
  items         OrderItem[]
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  nameEn    String
  nameBn    String
  size      String
  color     String
  price     Int
  quantity  Int
}
